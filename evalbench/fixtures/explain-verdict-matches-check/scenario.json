{
  "description": "the verdict explain reports equals what check --format json reports for the same reference",
  "steps": [
    {
      "cmd": "stamp",
      "args": [],
      "expect_exit": 0
    },
    {
      "cmd": "check",
      "args": ["--format", "json"],
      "write": {
        "t.md": "# H\n\n## Decision\n\nWe chose Y instead.\n"
      },
      "expect_exit": 1,
      "expect_contains": ["\"verdict\": \"DRIFTED\""]
    },
    {
      "cmd": "explain",
      "args": ["a.md:1"],
      "expect_exit": 1,
      "expect_contains": ["verdict     DRIFTED"]
    }
  ]
}
