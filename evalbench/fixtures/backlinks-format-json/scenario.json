{
  "description": "--format json output shape is stable: file, line, target, pin",
  "steps": [
    {
      "cmd": "backlinks",
      "args": [
        "t.md",
        "--format",
        "json"
      ],
      "expect_exit": 0,
      "expect_json_subset": {
        "findings": [
          {
            "file": "a.md",
            "line": 1,
            "target": "t.md",
            "pin": "unpinned"
          }
        ]
      }
    }
  ]
}
