{
  "description": "Editing the target of a stamped reference-style definition makes check report DRIFTED.",
  "steps": [
    {
      "cmd": "stamp",
      "args": [],
      "expect_exit": 0
    },
    {
      "cmd": "check",
      "args": ["--json"],
      "expect_exit": 0,
      "expect_json": []
    },
    {
      "write": {
        "t.md": "# H\n\n## Decision\n\nWe chose Y instead.\n"
      },
      "cmd": "check",
      "args": [],
      "expect_exit": 1,
      "expect_contains": [
        "DRIFTED (1)",
        "t.md#decision",
        "pinned @",
        "now @"
      ]
    }
  ]
}
