{
  "description": "`stamp --check` on a pin whose target changed since it was stamped exits nonzero.",
  "steps": [
    {
      "cmd": "stamp",
      "args": [],
      "expect_exit": 0
    },
    {
      "cmd": "check",
      "args": [],
      "write": {
        "t.md": "# H\n\n## Decision\n\nWe chose Y instead.\n"
      },
      "expect_exit": 1
    },
    {
      "cmd": "stamp",
      "args": ["--check", "--rebless"],
      "expect_exit": 1,
      "expect_contains": ["a.md:1", "stale"]
    }
  ]
}
