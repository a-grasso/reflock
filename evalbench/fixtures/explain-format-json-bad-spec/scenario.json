{
  "description": "BUG-07: explain --format json puts an invalid-spec error on stdout as {\"error\": ...}",
  "steps": [
    {
      "cmd": "explain",
      "args": ["not-a-spec", "--format", "json"],
      "expect_exit": 2,
      "expect_json": {"error": "invalid <file>:<line> spec: not-a-spec"},
      "expect_stderr_empty": true
    }
  ]
}
