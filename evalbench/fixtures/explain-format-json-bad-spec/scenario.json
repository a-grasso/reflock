{
  "description": "BUG-07 + AGT-01: explain --format json puts an invalid-spec error on stdout inside the envelope",
  "steps": [
    {
      "cmd": "explain",
      "args": [
        "not-a-spec",
        "--format",
        "json"
      ],
      "expect_exit": 2,
      "expect_stderr_empty": true,
      "expect_json_subset": {
        "findings": [],
        "error": {
          "message": "invalid <file>:<line> spec: not-a-spec",
          "kind": "usage"
        }
      }
    }
  ]
}
