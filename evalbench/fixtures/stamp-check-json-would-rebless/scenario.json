{
  "description": "AGT-05: a drifted pin under --rebless --check --format json reports action rebless with both digests - the dangerous action is named differently from the harmless one.",
  "steps": [
    {
      "cmd": "stamp",
      "args": [],
      "expect_exit": 0
    },
    {
      "write": {
        "t.md": "# T\n\nThe body, reworded.\n"
      },
      "cmd": "stamp",
      "args": [
        "--rebless",
        "--check",
        "--format",
        "json"
