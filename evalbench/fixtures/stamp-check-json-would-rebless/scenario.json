            "line": 1,
            "target": "t.md",
            "action": "rebless",
            "pinned": "7638c55a",
            "current": "d732fc4c"
          }
        ],
        "summary": {
          "stamp": 0,
          "rebless": 1
        },
        "problems": 1,
        "written": false
      },
      "expect_file_regex": {
        "a.md": "<!--@7638c55a-->"
      }
    }
  ]
}
