{
  "description": "stamp then check is OK; editing the target then check is DRIFTED.",
  "steps": [
    {
      "cmd": "stamp",
      "args": [],
      "expect_exit": 0
    },
    {
      "cmd": "check",
      "args": ["--json"],
      "expect_exit": 0,
      "expect_json": []
    },
    {
      "write": {
        "loader.md": "# Loader\n\nbody CHANGED\n"
      },
      "cmd": "check",
      "args": [],
      "expect_exit": 1,
      "expect_contains": [
        "DRIFTED (1)",
        "loader",
        "pinned @",
        "now @"
      ]
    }
  ]
}
