{
  "description": "AGT-01: -q is quiet for humans, not less JSON - the envelope survives intact on stdout",
  "steps": [
    {
      "cmd": "check",
      "args": [
        "-q",
        "--format",
        "json"
      ],
      "expect_exit": 1,
      "expect_stderr_empty": true,
      "expect_json_subset": {
        "command": "check",
        "problems": 1,
        "findings": [
          {
            "verdict": "DANGLING",
            "file": "a.md",
            "line": 1,
            "target": "gone.md"
          }
        ]
      }
    }
  ]
}
