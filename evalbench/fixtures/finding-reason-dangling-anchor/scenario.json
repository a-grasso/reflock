{
  "description": "AGT-02: an existing file with a missing fragment yields no-such-anchor, distinct from no-such-file - the repair is to fix the fragment, not the path.",
  "steps": [
    {
      "cmd": "check",
      "args": [
        "--format",
        "json"
      ],
      "expect_exit": 1,
      "expect_json_subset": {
        "findings": [
          {
            "verdict": "DANGLING",
            "file": "a.md",
            "line": 1,
            "target": "t.md#ghost",
            "reason": "no-such-anchor",
            "detail": "no anchor '#ghost' in t.md"
          }
        ]
      }
    }
  ]
}
