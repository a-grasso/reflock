{
  "description": "two files referencing a target both appear, sorted by referring file",
  "steps": [
    {
      "cmd": "backlinks",
      "args": [
        "t.md",
        "--format",
        "json"
      ],
      "expect_exit": 0,
      "expect_json_subset": {
        "findings": [
          {
            "file": "a.md",
            "line": 1,
            "target": "t.md",
            "pin": "unpinned"
          },
          {
            "file": "b.md",
            "line": 1,
            "target": "t.md",
            "pin": "unpinned"
          }
        ]
      }
    }
  ]
}
