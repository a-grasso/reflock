{
  "description": "Two references on the same line are both parsed; only the bad one is reported.",
  "steps": [
    {
      "cmd": "check",
      "args": [
        "--json"
      ],
      "expect_exit": 1,
      "expect_json_subset": {
        "findings": [
          {
            "verdict": "DANGLING",
            "file": "a.md",
            "line": 1,
            "target": "missing.md",
            "detail": "no such file: missing.md"
          }
        ]
      }
    }
  ]
}
