{
  "description": "`stamp` never fills a pin for a reference that doesn't resolve - it leaves it DANGLING.",
  "steps": [
    {
      "cmd": "stamp",
      "args": [],
      "expect_exit": 0,
      "expect_file_regex": {
        "a.md": "<!--@-->"
      }
    },
    {
      "cmd": "check",
      "args": [
        "--json"
      ],
      "expect_exit": 1,
      "expect_json": [
        {
          "verdict": "DANGLING",
          "file": "a.md",
          "line": 1,
          "target": "t.md#ghost",
          "detail": "no anchor '#ghost' in t.md"
        }
      ]
    }
  ]
}
