{
  "description": "A markdown link to a file that doesn't exist is DANGLING.",
  "steps": [
    {
      "cmd": "check",
      "args": [
        "--json"
      ],
      "expect_exit": 1,
      "expect_json": [
        {
          "verdict": "DANGLING",
          "file": "a.md",
          "line": 1,
          "target": "missing.md",
          "detail": "no such file: missing.md"
        }
      ]
    }
  ]
}
