{
  "description": "`[[text]](target)` is a markdown link whose text is bracketed, not a wiki-link to the display text (issue #19): it reports nothing and stamps as the markdown link.",
  "steps": [
    {
      "cmd": "check",
      "args": [
        "--json"
      ],
      "expect_exit": 1,
      "expect_json_subset": {
        "findings": [
          {
            "verdict": "UNSTAMPED",
            "target": "../README.md"
          }
        ]
      }
    },
    {
      "cmd": "stamp",
      "args": [],
      "expect_exit": 0
    },
    {
      "cmd": "check",
      "args": [
        "--json"
      ],
      "expect_exit": 0,
      "expect_json_subset": {
        "findings": []
      }
    },
    {
      "write": {
        "README.md": "# R\n\nbody CHANGED\n"
      },
      "cmd": "check",
      "args": [],
      "expect_exit": 1,
      "expect_contains": [
        "DRIFTED (1)",
        "docs/guide.md:3",
        "../README.md"
      ]
    }
  ]
}
