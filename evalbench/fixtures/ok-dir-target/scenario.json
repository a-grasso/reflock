{
  "description": "A link to a directory (not a file) is OK with detail 'dir'.",
  "steps": [
    {
      "cmd": "check",
      "args": [
        "--json",
        "--verbose"
      ],
      "expect_exit": 0,
      "expect_json_subset": {
        "findings": [
          {
            "verdict": "OK",
            "file": "a.md",
            "line": 1,
            "target": "assets",
            "detail": "dir"
          }
        ]
      }
    }
  ]
}
