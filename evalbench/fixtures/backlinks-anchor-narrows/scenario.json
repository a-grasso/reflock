{
  "description": "a target with an anchor lists only references to that anchor, not bare file references",
  "steps": [
    {
      "cmd": "backlinks",
      "args": [
        "t.md#real",
        "--format",
        "json"
      ],
      "expect_exit": 0,
      "expect_json_subset": {
        "findings": [
          {
            "file": "a.md",
            "line": 1,
            "target": "t.md#real",
            "pin": "unpinned"
          }
        ]
      }
    }
  ]
}
