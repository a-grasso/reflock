{
  "description": "AGT-05: a scope error under stamp --format json lands the envelope on stdout with error.kind and exit 2, stderr empty. It closes the exception the manual used to document - that stamp had no --format and so always errored in the plain stderr form.",
  "steps": [
    {
      "cmd": "stamp",
      "args": [
        "--format",
        "json",
        "nope.md"
      ],
      "expect_exit": 2,
      "expect_stderr_empty": true,
      "expect_json_subset": {
        "command": "stamp",
        "findings": [],
        "summary": {
          "stamp": 0,
          "rebless": 0
        },
        "written": false,
        "error": {
          "kind": "scope",
          "message": "no such path in tree: nope.md"
        }
      }
    },
    {
      "cmd": "stamp",
      "args": [
        "--warn",
        "--format",
        "json"
      ],
      "expect_exit": 2,
      "expect_stderr_empty": true,
      "expect_json_subset": {
        "command": "stamp",
        "findings": [],
        "written": false,
        "error": {
          "kind": "usage",
          "message": "--warn requires --check"
        }
      },
      "expect_tree_unchanged_since_step": 0
    }
  ]
}
