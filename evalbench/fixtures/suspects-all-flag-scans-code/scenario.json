{
  "description": "Without --all, suspects only scans markdown; --all extends it to every file.",
  "steps": [
    {
      "cmd": "suspects",
      "args": [
        "--json"
      ],
      "expect_exit": 0,
      "expect_json_subset": {
        "findings": []
      }
    },
    {
      "cmd": "suspects",
      "args": [
        "--all",
        "--json"
      ],
      "expect_exit": 1,
      "expect_json_subset": {
        "findings": [
          {
            "file": "lib.py",
            "line": 1,
            "target": "other/module.py"
          }
        ]
      }
    }
  ]
}
