{
  "description": "A reference-style definition with no usage anywhere in the file is still parsed and checked.",
  "steps": [
    {
      "cmd": "check",
      "args": [
        "--json"
      ],
      "expect_exit": 1,
      "expect_json_subset": {
        "findings": [
          {
            "verdict": "DANGLING",
            "file": "a.md",
            "line": 3,
            "target": "missing.md",
            "detail": "no such file: missing.md"
          }
        ]
      }
    }
  ]
}
